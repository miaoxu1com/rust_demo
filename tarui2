App.vue定义前端
<script setup>
import { ref } from "vue";
import { invoke } from "@tauri-apps/api/core";

const greetMsg = ref("");
const name = ref("");

async function greet() {
  // Learn more about Tauri commands at https://tauri.app/develop/calling-rust/
  greetMsg.value = await invoke("greet", { name: name.value });
}
</script>

<template>
  <div class="container">
    <div class="d-grid gap-4 mx-auto">
      <div class="d-grid gap-2 col-5 mx-auto">
        <label>邮箱地址</label>
        <input type="text" class="form-control" v-model="email" id="email"></input>
      </div>
      <div class="d-grid gap-4 col-4 mx-auto">
        <b-button class="btn btn-primary" @click="sendEmail" :disabled="isSending">发送</b-button>
        <b-button class="btn btn-primary" @click="openEmail">查看邮箱</b-button>
      </div>
    </div>
  </div>
</template>

<script>
export default {
  data() {
    return {
      name: '',
      greetMsg: ''
    };
  },
  methods: {
    greet() {
      this.greetMsg = `Hello, ${this.name}!`;
    }
  }
};
</script>

